# Keep executable scripts and Linux-facing build files usable from WSL, CI, and
# Linux checkouts even when contributors use Windows with core.autocrlf=true.
* text=auto

*.py text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.asm text eol=lf
*.ld text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

.gitattributes text eol=lf
.env.example text eol=lf
**/.env.example text eol=lf
Makefile text eol=lf
**/Makefile text eol=lf
